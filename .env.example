# Copy to .env and set the deployment values. Never store school credentials here.
MOON_IMAGE=moonuestc-local:student-portal
PUID=10001
PGID=10001
MOON_PORT=8088
MOON_BIND_ADDRESS=127.0.0.1
# REQUIRED: browser address, including non-default HTTPS port.
MOON_PUBLIC_URL=https://YOUR_PUBLIC_IP_OR_DOMAIN:8443
MOON_ALLOW_INSECURE_HTTP=0
MOON_DATA_DIR=./data
# Optional; keep distinct when installing more than one instance.
COMPOSE_PROJECT_NAME=moonuestc
# Optional Python build base:
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm

# Independent self-registration is disabled; users authenticate through school.
MOON_ALLOW_REGISTRATION=0
# Donson dual-interface fork. Student signup requires real school verification.
MOON_ENABLE_PORTAL=1
# Optional: enable per-owner consent and refreshable WeChat authorization.
# Set to 1 to obtain fresh school operation tickets for daily automatic plans.
MOON_ENABLE_WECHAT_AUTH=0
# Trust only the actual same-host proxy address; never trust all container/LAN IPs.
MOON_TRUSTED_PROXY_CIDRS=
# Portal production uses a public student listener and a separate private admin.
# Empty infers public for portal mode, or combined for the legacy dashboard.
MOON_SURFACE=public
# Optional deployment-specific cohort, location, and execution boundaries.
MOON_STUDENT_ID_PREFIX=
MOON_ALLOWED_PRESETS=xuezhi_group2_amap,xuezhi_group5_amap
MOON_RUN_WINDOW=21:06,23:24
# Include compose.admin.yaml; expose only via a restricted SSH local forward.
MOON_ADMIN_PORT=4497
MOON_BROWSER_IMAGE=moonuestc-browser:local
MOON_BROWSER_ASSIST_URL=http://school-browser:8090
MOON_BROWSER_ASSIST_KEY=
MOON_REQUIRE_CONSENT=1
