# Replace the server name, listener port, and certificate paths for your host.
server {
    listen 8443 ssl;
    server_name YOUR_PUBLIC_IP_OR_DOMAIN;
    ssl_certificate /YOUR/CERTIFICATE/fullchain.pem;
    ssl_certificate_key /YOUR/CERTIFICATE/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}
